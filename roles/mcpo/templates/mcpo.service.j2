[Unit]
Description=Model Context Protocol Proxy (mcpo)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ mcpo_user }}
Group={{ mcpo_group }}
WorkingDirectory={{ mcpo_install_dir }}
EnvironmentFile={{ mcpo_env_file }}
Environment=PATH={{ mcpo_venv_dir }}/bin:/usr/local/bin:/usr/bin:/bin
{% for key, val in mcpo_extra_env.items() %}
Environment={{ key }}={{ val }}
{% endfor %}
ExecStart={{ mcpo_venv_dir }}/bin/mcpo --host {{ mcpo_host }} --port {{ mcpo_port }} --config {{ mcpo_config_file }} --hot-reload
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
