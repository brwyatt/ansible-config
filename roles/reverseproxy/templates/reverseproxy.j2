server {
  server_name {{ " ".join(item.server_names) }};

  listen 80;

  return 301 https://$host$request_uri;
}

server {
  server_name {{ " ".join(item.server_names) }};

  listen 443 ssl http2;

  ssl_certificate /etc/letsencrypt/live/{{ item.server_names[0] }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ item.server_names[0] }}/privkey.pem;

  include snippets/ssl.conf;

{% if reverseproxy_trusted_proxies is defined %}
{% for proxy in reverseproxy_trusted_proxies %}
  set_real_ip_from {{ proxy }};
{% endfor %}
  real_ip_header X-Forwarded-For;
{% if reverseproxy_recursive_proxies %}
  real_ip_recursive on;
{% endif %}

{% endif %}
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $http_connection;
  proxy_http_version 1.1;
{% for directive in item.server_directives|default([]) %}
{% if loop.first %}

{% endif %}
  {{ directive }}
{% endfor %}
{% if item.sso_enabled|default(false) %}

  location /authelia {
    internal;
    proxy_pass {{ reverseproxy_sso_verify_url }};
    proxy_set_header Host {{ reverseproxy_sso_verify_host }};
    proxy_ssl_server_name on;
    proxy_ssl_name {{ reverseproxy_sso_verify_host }};
    proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Forwarded-Method $request_method;
    proxy_set_header Content-Length "";
    proxy_pass_request_body off;

{% if item.sso_cache_enabled | default(reverseproxy_sso_cache_enabled) %}
    # Caching
    proxy_cache auth_cache;
    proxy_cache_key "$remote_addr|$cookie_authelia_session|$request_method|$http_host|$request_uri";
    proxy_cache_valid 200 {{ item.sso_cache_valid | default(reverseproxy_sso_cache_valid) }};
    proxy_cache_valid 401 403 0s;
    proxy_cache_valid any 0s;
    proxy_cache_bypass $auth_cache_bypass_referer $auth_cache_bypass_cc $auth_cache_bypass_pragma;
    proxy_cache_use_stale error timeout invalid_header http_500 http_502 http_503 http_504;
{% else %}
    proxy_cache off;
{% endif %}
  }
{% endif %}

  # Initialize SSO variables
  set $user "";
  set $groups "";
  set $name "";
  set $email "";

  location @backend {
    proxy_pass {{ item.destination }};
    proxy_set_header Remote-User $user;
    proxy_set_header Remote-Groups $groups;
    proxy_set_header Remote-Name $name;
    proxy_set_header Remote-Email $email;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    proxy_http_version 1.1;

    add_header X-Served-By $host;

    proxy_redirect off;
    proxy_read_timeout 120;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Scheme $scheme;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

{% if item.healthcheck is defined %}
  location {{ item.healthcheck.path | default('/health') }} {
    auth_request off;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /usr/local/bin/nginx-healthcheck.sh;
    {% set health_vars = namespace(check_strings=[]) %}
    {% for c in item.healthcheck.checks %}
      {% if c.type == 'port' %}
        {% set health_vars.check_strings = health_vars.check_strings + ['port:' ~ (c.value | default(proxy_port | default(80)))] %}
      {% elif c.type == 'service' %}
        {% set health_vars.check_strings = health_vars.check_strings + ['service:' ~ c.value] %}
      {% elif c.type == 'pgrep' %}
        {% set health_vars.check_strings = health_vars.check_strings + ['pgrep:' ~ c.value] %}
      {% elif c.type == 'custom' %}
        {% set health_vars.check_strings = health_vars.check_strings + ['custom:' ~ c.value] %}
      {% endif %}
    {% endfor %}
    fastcgi_param CHECKS "{{ health_vars.check_strings | join(';') }}";
    fastcgi_pass unix:/var/run/fcgiwrap.socket;
  }
{% endif %}

{% for public in item.public_paths | default([]) %}
  location {{ public }} {
    auth_request off;
    try_files /dev/null/nonexistent @backend;
  }
{% endfor %}

{% for regex in item.public_paths_regex | default([]) %}
  location ~ {{ regex }} {
    auth_request off;
    try_files /dev/null/nonexistent @backend;
  }
{% endfor %}

  location / {
{% if item.sso_enabled|default(false) %}
    auth_request /authelia;
{%   if item.sso_optional|default(false) %}
    error_page 401 403 = @backend;
{%   else %}
    error_page 401 =302 {{ reverseproxy_sso_url }}/?rd=$scheme://$http_host$request_uri;
{%   endif %}

    auth_request_set $user $upstream_http_remote_user;
    auth_request_set $groups $upstream_http_remote_groups;
    auth_request_set $name $upstream_http_remote_name;
    auth_request_set $email $upstream_http_remote_email;

{% endif %}
    try_files /dev/null/nonexistent @backend;
  }
}
