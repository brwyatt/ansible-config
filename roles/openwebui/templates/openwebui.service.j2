[Unit]
Description=Open WebUI Service
After=network.target

[Service]
Type=simple
User={{ openwebui_user }}
Group={{ openwebui_group }}
WorkingDirectory={{ openwebui_install_dir }}
Environment=PORT={{ openwebui_port }}
Environment=DATA_DIR={{ openwebui_install_dir }}/data
Environment=HF_HOME={{ openwebui_install_dir }}/data/cache/huggingface
{% if openwebui_db_url %}
Environment=DATABASE_URL={{ openwebui_db_url }}
{% endif %}
{% if openwebui_secret_key %}
Environment=WEBUI_SECRET_KEY={{ openwebui_secret_key }}
{% endif %}
Environment=ENABLE_SIGNUP={{ 'True' if openwebui_enable_signup else 'False' }}
{% if not openwebui_enable_ollama %}
Environment=ENABLE_OLLAMA_API=False
{% endif %}
Environment=WEBUI_URL={{ openwebui_webui_url }}

{% if openwebui_enable_oidc %}
# Authelia OIDC Client Integration
Environment=ENABLE_LOGIN_FORM={{ 'False' if openwebui_disable_login_form else 'True' }}
Environment=ENABLE_OAUTH_PERSISTENT_CONFIG=False
Environment=ENABLE_OAUTH_SIGNUP={{ 'True' if openwebui_enable_oauth_signup else 'False' }}
Environment=OPENID_REDIRECT_URI={{ openwebui_webui_url }}/oauth/oidc/callback
Environment=OAUTH_AUTO_REDIRECT={{ 'True' if openwebui_oauth_auto_redirect else 'False' }}
Environment=OAUTH_MERGE_ACCOUNTS_BY_EMAIL={{ 'True' if openwebui_oauth_merge_accounts_by_email else 'False' }}
Environment=OAUTH_CLIENT_ID={{ openwebui_oauth_client_id }}
Environment=OAUTH_CLIENT_SECRET={{ openwebui_oauth_client_secret }}
Environment=OPENID_PROVIDER_URL={{ openwebui_openid_provider_url }}
Environment=OAUTH_PROVIDER_NAME="{{ openwebui_oauth_provider_name }}"
Environment=OAUTH_SCOPES="{{ openwebui_oauth_scopes }}"
Environment=ENABLE_OAUTH_ROLE_MANAGEMENT={{ 'True' if openwebui_enable_oauth_role_management else 'False' }}
Environment=OAUTH_ROLES_CLAIM={{ openwebui_oauth_roles_claim }}
Environment=OAUTH_ALLOWED_ROLES={{ openwebui_oauth_allowed_roles }}
Environment=OAUTH_ADMIN_ROLES={{ openwebui_oauth_admin_roles }}
Environment=OAUTH_CODE_CHALLENGE_METHOD={{ openwebui_oauth_code_challenge_method }}
{% endif %}

# Additional parameters
{% for key, val in openwebui_extra_env.items() %}
Environment={{ key }}={{ val }}
{% endfor %}

ExecStart={{ openwebui_venv_dir }}/bin/open-webui serve --host {{ openwebui_host }} --port {{ openwebui_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
